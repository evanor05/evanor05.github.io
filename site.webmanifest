---
layout: null
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "lang": {{ site.lang | default: 'zh-CN' | jsonify }},
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "minimal-ui",
  "background_color": "#ffffff",
  "theme_color": "#f8f8f8",
  "icons": [
    {
      "src": "{{ '/assets/images/favicon-32.png' | relative_url }}",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "{{ '/assets/images/apple-touch-icon.png' | relative_url }}",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
